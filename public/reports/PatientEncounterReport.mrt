      <DataSource1 Ref="5" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="2">
          <value>department_name,System.String</value>
          <value>total_encounters,System.Int64</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>4cdfd06e85044ac48688edafaaf708a2</Key>
        <Name>DataSource1</Name>
        <NameInSource>PostgreSQL</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
    d.name AS department_name,
    COUNT(pe.id) AS total_encounters
FROM patient_encounters pe
JOIN department d
    ON d.id = pe.department_id
GROUP BY d.name
ORDER BY total_encounters DESC;</SqlCommand>
      </DataSource1>
      <DataSource3 Ref="6" type="Stimulsoft.Report.Dictionary.StiPostgreSQLSource" isKey="true">
        <Alias>DataSource3</Alias>
        <Columns isList="true" count="3">
          <value>ORIGINAL,encounter_number,encounter_number,encounter_number,System.String,_x0033_a9ca57c8f2f4e4ab0b7c68ab2f66d6d</value>
          <value>ORIGINAL,status,status,status,System.String,_x0037_e58b3e76b2042bca6c79188557427fe</value>
          <value>ORIGINAL,department_name,department_name,department_name,System.String,_x0033_ce19acae0464e9989bfd7f264d21749</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>ce24fca887be422abc7f50806c361157</Key>
        <Name>DataSource3</Name>
        <NameInSource>PostgreSQL</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT
    pe.encounter_number,
    pe.status,
    d.name AS department_name
FROM patient_encounters pe
JOIN department d
    ON d.id = pe.department_id
WHERE
(
    @StatusFilter = 'ALL'
    OR pe.status = @StatusFilter
)
AND
(
    @DepartmentFilter = 'ALL'
    OR d.name = @DepartmentFilter
)
ORDER BY pe.created_date DESC</SqlCommand>
      </DataSource3>
    </DataSources>
